# Copy this file to .env and adjust. Every value below is optional and shows its default.
# Never commit your real .env (it is already in .gitignore).

# --- Server ---
# Port the app listens on.
PORT=3000
# Interface to bind. 127.0.0.1 = only this machine (safest).
# Use 0.0.0.0 only if other devices must reach the app directly.
HOST=127.0.0.1

# --- Data ---
# Folder for the SQLite database (portfolio.db). Relative paths are resolved
# from the project folder. Keep it OUTSIDE the code folder in production.
DATA_DIR=.

# --- Backups (npm run backup) ---
# Where backups go. Default: <DATA_DIR>/backups
# BACKUP_DIR=./backups
# How many backups to keep (newest first).
BACKUP_RETAIN=30

# --- Accounts ---
# Set to false after creating your own account to close sign-ups.
ALLOW_REGISTRATION=true
# Days until a login session expires (1-90).
SESSION_TTL_DAYS=7

# --- Behind HTTPS / reverse proxy ---
# Send the session cookie only over HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
# Trust X-Forwarded-For from a local reverse proxy (e.g. tailscale serve, nginx).
# Needed so rate limiting sees the real client IP. Example: loopback
# TRUST_PROXY=loopback

# --- Abuse protection ---
# Max login/register attempts per IP every 15 minutes.
AUTH_RATE_LIMIT=10
# Max API requests per IP per minute.
API_RATE_LIMIT=300

# --- Market data ---
# Each user saves their own Finnhub key inside the app (onboarding screen).
# There is no server-wide key anymore.
# How long a quote stays cached, in milliseconds.
QUOTE_CACHE_TTL_MS=30000

# --- Charts (historical candles) ---
# Crypto: Coinbase (real time, no key), Binance as fallback (no key).
# US stocks: each user saves their own Alpaca key in Settings > Conta (free plan:
# all exchanges with 15 min delay, history since 2016).
# Massive (ex-Polygon) key: fallback for charts and crypto search. Free plan: 2 years
# of history, 5 requests per minute (the server caches and paces calls).
# Advanced/testing only: alternative base URLs (e.g. a local mock).
# MASSIVE_BASE_URL=https://api.massive.com
# ALPACA_DATA_URL=https://data.alpaca.markets
# COINBASE_BASE_URL=https://api.exchange.coinbase.com
# BINANCE_BASE_URL=https://api.binance.com
# COINBASE_RATES_URL=https://api.coinbase.com
# BCB_PTAX_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata
